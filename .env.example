# Supabase Configuration (Remote - for development)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Database (for Supabase CLI commands)
SUPABASE_DB_PASSWORD=your_database_password

# Supabase service role key. SERVER ONLY: it bypasses Row Level Security. Needed by the payment webhooks and the /api/billing routes.
# Supabase dashboard > Project settings > API > service_role. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─────────────────────────────────────────────────────────
# Billing (see BILLING.md). `npm run billing:check` says which provider takes new checkouts and what is still missing.
# ─────────────────────────────────────────────────────────
# Which provider takes NEW checkouts: paddle | polar. Switching it never touches existing subscribers (BILLING.md, "Switching provider").
# Leave it empty only while exactly one provider is configured.
BILLING_PROVIDER=paddle

# ── Paddle: `npm run paddle:check` ──
# A short name for THIS app, unique on your Paddle account (lowercase, digits, - and _). Stamped on everything the app creates in Paddle.
PADDLE_APP_TAG=my-app
# sandbox | production. The API key must match: pdl_sdbx_... in the sandbox, pdl_live_... in production (anything else is refused).
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Paddle > Developer tools > Authentication. The API key is SECRET and server only; the client-side token (test_... / live_...) is public.
PADDLE_API_KEY=pdl_sdbx_apikey_...
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
# The signing secret of the notification destination: `npm run paddle:webhook -- https://<your domain>/api/webhooks/paddle --write`.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# One line per plan interval / product of src/config/billing.ts: `npm run paddle:catalog -- --write` creates them in Paddle and writes them here.
# PADDLE_PRICE_PRO_MONTH=pri_...
# PADDLE_PRICE_PRO_YEAR=pri_...
# PADDLE_PRICE_TEAM_MONTH=pri_...
# PADDLE_PRICE_TEAM_YEAR=pri_...

# ── Polar: `npm run polar:check` ──
# sandbox (default) | production. Polar tokens look the same in both: this decides which server they are sent to.
# POLAR_SERVER=sandbox
# Settings > Developers > organization access token: scopes checkouts:write, customer_sessions:write, subscriptions:read, orders:read
# (+ products:read for polar:check, webhooks:read/write for polar:webhook: add them for the setup, take them off after). SECRET, server only.
# POLAR_ACCESS_TOKEN=polar_oat_...
# The signing secret of the webhook endpoint: `npm run polar:webhook -- https://<your domain>/api/webhooks/polar --write`.
# POLAR_WEBHOOK_SECRET=...
# One line per plan interval / product of src/config/billing.ts: create the products in the Polar dashboard (`npm run polar:catalog` lists them) and paste the ids.
# POLAR_PRODUCT_PRO_MONTH=...
# POLAR_PRODUCT_PRO_YEAR=...
# POLAR_PRODUCT_TEAM_MONTH=...
# POLAR_PRODUCT_TEAM_YEAR=...
